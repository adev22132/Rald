                                    u_xlat4.y = dot(u_xlat7.xyz, u_xlat1.xyz);
                                    u_xlat3.xy = u_xlat2.zw;
                                    u_xlat4.z = dot(u_xlat8.xyz, u_xlat3.xyz);
                                    u_xlat4.w = dot(u_xlat11.xyz, u_xlat3.xyz);
                                    u_xlat12 = dot(u_xlat7.xyz, u_xlat3.xyz);
