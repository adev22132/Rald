vec4 u_xlat0;
bool u_xlatb0;
vec3 u_xlat1;
uint u_xlatu1;
vec4 u_xlat2;
vec4 u_xlat3;
vec4 u_xlat4;
float u_xlat5;
uint u_xlatu5;
vec3 u_xlat6;
